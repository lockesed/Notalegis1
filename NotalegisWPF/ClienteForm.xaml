<Window x:Class="NotalegisWPF.ClienteForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notalegis" Height="600" Width="900"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- FORMULARIO -->
        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0 0 0 10">
            <WrapPanel Margin="0 0 0 5">
                <TextBox x:Name="txtNombre" Width="150" Margin="5" 
                         materialDesign:HintAssist.Hint="Nombre"/>
                <TextBox x:Name="txtApellido" Width="150" Margin="5" 
                         materialDesign:HintAssist.Hint="Apellido"/>
                <TextBox x:Name="txtDNI" Width="150" Margin="5" 
                         materialDesign:HintAssist.Hint="DNI"/>
                <TextBox x:Name="txtEdad" Width="100" Margin="5" 
                         materialDesign:HintAssist.Hint="Edad"/>
                <TextBox x:Name="txtTelefono" Width="150" Margin="5" 
                         materialDesign:HintAssist.Hint="Teléfono"/>
            </WrapPanel>
            <WrapPanel Margin="0 0 0 5">
                <TextBox x:Name="txtEmail" Width="200" Margin="5" 
                         materialDesign:HintAssist.Hint="Email"/>
                <TextBox x:Name="txtDireccion" Width="300" Margin="5" 
                         materialDesign:HintAssist.Hint="Dirección"/>
                <ComboBox x:Name="cmbEstado" Width="220" Margin="5"
                          materialDesign:HintAssist.Hint="Estado del Cliente">
                    <ComboBoxItem>a la espera de escritura</ComboBoxItem>
                    <ComboBoxItem>a la espera de que brinde documentacion</ComboBoxItem>
                    <ComboBoxItem>tiene turno confirmado</ComboBoxItem>
                    <ComboBoxItem>no tiene turno confirmado</ComboBoxItem>
                    <ComboBoxItem>tiene reunion agendada</ComboBoxItem>
                    <ComboBoxItem>comunicarse con cliente</ComboBoxItem>
                </ComboBox>
                <Button x:Name="btnActualizarEstado" Content="Actualizar Estado" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="5" Width="150"/>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="btnGuardar" Content="Guardar" Margin="5" Width="100"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button x:Name="btnModificar" Content="Modificar" Margin="5" Width="100"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button x:Name="btnEliminar" Content="Eliminar" Margin="5" Width="100"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button x:Name="btnLimpiar" Content="Limpiar" Margin="5" Width="100"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </WrapPanel>
        </StackPanel>

        <!-- DATAGRID CLIENTES -->
        <DataGrid x:Name="dgvClientes" Grid.Row="1" Margin="0 0 0 10"
                  AutoGenerateColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  SelectionUnit="FullRow"
                  Background="{DynamicResource MaterialDesignPaper}"
                  Foreground="{DynamicResource MaterialDesignBody}" />

        <!-- HISTORIAL DE ESTADO -->
        <GroupBox Header="Historial de Estado" Grid.Row="2" Margin="0">
            <DataGrid x:Name="dgvHistorialEstados"
                      AutoGenerateColumns="True"
                      Background="{DynamicResource MaterialDesignPaper}"
                      Foreground="{DynamicResource MaterialDesignBody}" />
        </GroupBox>
    </Grid>
</Window>
