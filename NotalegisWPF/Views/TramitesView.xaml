<Window x:Class="Notalegis.Views.TramitesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notalegis — Gestión de Trámites"
        Icon="/Resources/logo.png"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Gestión de Trámites" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Cerrar" Style="{StaticResource SecondaryButton}"
                        Padding="14,7" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="btnCerrar_Click"/>
            </Grid>
        </Border>

        <!-- Contenido principal: sin ScrollViewer de página completa, para que la
             grilla de trámites (Grid.Row="1" del panel derecho) tenga su propio
             scroll interno y los botones de abajo queden siempre visibles. -->
        <Grid Grid.Row="1" Margin="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Panel izquierdo: Formulario ===== -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Nuevo Trámite" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <ComboBox x:Name="cmbCliente" Margin="0,4,0,10"
                                      materialDesign:HintAssist.Hint="Seleccionar Cliente"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                                      IsEditable="True"/>

                            <ComboBox x:Name="cmbTipoTramite" Margin="0,4,0,10"
                                      materialDesign:HintAssist.Hint="Tipo de Trámite"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                                      SelectionChanged="cmbTipoTramite_SelectionChanged">
                                <ComboBoxItem Content="Escritura de Compraventa"/>
                                <ComboBoxItem Content="Constitución de Sociedad"/>
                                <ComboBoxItem Content="Poder General"/>
                                <ComboBoxItem Content="Certificado de Dominio"/>
                                <ComboBoxItem Content="Testamento"/>
                                <ComboBoxItem Content="Donación"/>
                                <ComboBoxItem Content="Hipoteca"/>
                                <ComboBoxItem Content="Cancelación de Hipoteca"/>
                                <ComboBoxItem Content="Usufructo"/>
                                <ComboBoxItem Content="Servidumbre"/>
                            </ComboBox>

                            <TextBlock Text="O ingresá un trámite personalizado:"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,4"/>
                            <TextBox x:Name="txtTramitePersonalizado" Margin="0,0,0,4"
                                     materialDesign:HintAssist.Hint="Tipo de trámite personalizado"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     TextChanged="txtTramitePersonalizado_TextChanged"/>
                            <TextBlock x:Name="lblTramiteValidacion" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"
                                       Text="El trámite personalizado debe tener al menos 3 caracteres"/>

                            <DatePicker x:Name="dpFechaInicio" Margin="0,4,0,10"
                                        materialDesign:HintAssist.Hint="Fecha de Inicio"
                                        materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>

                            <DatePicker x:Name="dpFechaVencimiento" Margin="0,4,0,10"
                                        materialDesign:HintAssist.Hint="Fecha de Vencimiento"
                                        materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>

                            <ComboBox x:Name="cmbEstado" Margin="0,4,0,10"
                                      materialDesign:HintAssist.Hint="Estado del Trámite"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                                <ComboBoxItem Content="Pendiente" IsSelected="True"/>
                                <ComboBoxItem Content="En Proceso"/>
                                <ComboBoxItem Content="Documentación Incompleta"/>
                                <ComboBoxItem Content="Esperando Cliente"/>
                                <ComboBoxItem Content="Finalizado"/>
                                <ComboBoxItem Content="Vencido"/>
                                <ComboBoxItem Content="Cancelado"/>
                            </ComboBox>

                            <ComboBox x:Name="cmbPrioridad" Margin="0,4,0,10"
                                      materialDesign:HintAssist.Hint="Prioridad"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                                <ComboBoxItem Content="Baja"/>
                                <ComboBoxItem Content="Media" IsSelected="True"/>
                                <ComboBoxItem Content="Alta"/>
                                <ComboBoxItem Content="Urgente"/>
                            </ComboBox>

                            <TextBox x:Name="txtObservaciones" Margin="0,4,0,10"
                                     materialDesign:HintAssist.Hint="Observaciones"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>

                            <CheckBox x:Name="chkDocumentacionCompleta" Margin="0,4,0,16"
                                      Content="Documentación Completa"
                                      Style="{StaticResource MaterialDesignCheckBox}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnLimpiar" Content="Limpiar"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" Margin="0,0,10,0"
                                        Click="btnLimpiar_Click"/>
                                <Button x:Name="btnGuardar" Content="Guardar"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="14,8" Click="btnGuardar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===== Panel derecho: Lista + Acciones ===== -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0" x:Name="txtBuscar" Margin="0,0,8,8"
                                     materialDesign:HintAssist.Hint="Buscar por cliente o tipo"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     TextChanged="txtBuscar_TextChanged"/>

                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbFiltroEstado" Margin="8,0,0,8"
                                      materialDesign:HintAssist.Hint="Estado"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                                      SelectionChanged="cmbFiltro_SelectionChanged">
                                <ComboBoxItem Content="Todos los Estados"/>
                                <ComboBoxItem Content="Pendiente"/>
                                <ComboBoxItem Content="En Proceso"/>
                                <ComboBoxItem Content="Documentación Incompleta"/>
                                <ComboBoxItem Content="Esperando Cliente"/>
                                <ComboBoxItem Content="Finalizado"/>
                                <ComboBoxItem Content="Vencido"/>
                                <ComboBoxItem Content="Cancelado"/>
                            </ComboBox>

                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="cmbFiltroPrioridad" Margin="0,0,8,0"
                                      materialDesign:HintAssist.Hint="Prioridad"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                                      SelectionChanged="cmbFiltro_SelectionChanged">
                                <ComboBoxItem Content="Todas las Prioridades"/>
                                <ComboBoxItem Content="Baja"/>
                                <ComboBoxItem Content="Media"/>
                                <ComboBoxItem Content="Alta"/>
                                <ComboBoxItem Content="Urgente"/>
                            </ComboBox>

                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbFiltroVencimiento" Margin="8,0,0,0"
                                      materialDesign:HintAssist.Hint="Vencimiento"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                                      SelectionChanged="cmbFiltro_SelectionChanged">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="Vencen Hoy"/>
                                <ComboBoxItem Content="Vencen Esta Semana"/>
                                <ComboBoxItem Content="Vencen Este Mes"/>
                                <ComboBoxItem Content="Ya Vencidos"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <Grid>
                            <DataGrid x:Name="dgTramites"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True"
                                      Style="{StaticResource ModernDataGrid}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      SelectionChanged="dgTramites_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="110"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTramite}" Width="120"/>
                                    <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=dd/MM/yy}" Width="70"/>
                                    <DataGridTextColumn Header="Vencimiento" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yy}" Width="80"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                                    <DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Doc." Binding="{Binding DocumentacionCompleta}" Width="45"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}"
                                                            ToolTip="Editar" Click="btnEditar_Click">
                                                        <TextBlock Text="&#xE70F;" Style="{StaticResource AccionIconoEditar}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            ToolTip="Eliminar" Click="btnEliminar_Click">
                                                        <TextBlock Text="&#xE107;" Style="{StaticResource AccionIconoEliminar}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            ToolTip="Consultar" Click="btnConsultar_Click">
                                                        <TextBlock Text="&#xE8FF;" Style="{StaticResource AccionIconoSecundario}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            ToolTip="Documentos" Click="btnDocumentos_Click">
                                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource AccionIconoSecundario}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Estado vacío -->
                            <Border x:Name="borderSinTramites" Visibility="Collapsed"
                                    Background="White" CornerRadius="12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="0,40">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="48" Foreground="{StaticResource BorderLightBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <TextBlock Text="No hay trámites que coincidan"
                                               HorizontalAlignment="Center" FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Cambiá los filtros o agregá un nuevo trámite."
                                               HorizontalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Paginación -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="btnTramiteAnterior" Content="◀ Anterior"
                                Style="{StaticResource SecondaryButton}" Padding="14,7"
                                Click="btnTramiteAnterior_Click"/>
                        <TextBlock x:Name="txtInfoPaginaTramites" Text="Página 1 de 1"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0"/>
                        <Button x:Name="btnTramiteSiguiente" Content="Siguiente ▶"
                                Style="{StaticResource SecondaryButton}" Padding="14,7"
                                Click="btnTramiteSiguiente_Click"/>
                    </StackPanel>

                    <!-- Botones de acciones -->
                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,12,6,0">
                                <Button Content="Exportar listado" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        Click="btnListadoDiario_Click"/>
                                <Button Content="Alerta firma" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="btnAlertaVencimiento_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="6,12,6,0">
                                <Button Content="Vencimientos hoy" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        Click="btnVencimientosHoy_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="6,12,0,0">
                                <Button Content="Actualizar lista" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                        Click="btnActualizarLista_Click"/>
                                <Button Content="Estadísticas" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Click="btnEstadisticas_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
    </Grid>
</Window>
