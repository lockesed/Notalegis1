<Window x:Class="Notalegis.Views.UsuariosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notalegis — Gestión de Usuarios"
        Icon="/Resources/logo.png"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        Loaded="UsuariosView_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Gestión de Usuarios" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer x:Name="scrollContenido" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">

                <!-- Formulario nuevo usuario -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="txtTituloFormulario" Text="Nuevo usuario" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtNombreUsuario" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Nombre de Usuario"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                            <PasswordBox x:Name="txtPassword" Grid.Column="2"
                                         materialDesign:HintAssist.Hint="Contraseña"
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisPasswordBox}"/>

                            <ComboBox x:Name="cmbRol" Grid.Column="4"
                                      materialDesign:HintAssist.Hint="Rol del Usuario"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Escribana Adjunta"/>
                                <ComboBoxItem Content="Secretaria"/>
                                <ComboBoxItem Content="Procurador"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Limpiar" Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Margin="0,0,10,0"
                                    Click="btnLimpiar_Click"/>
                            <Button x:Name="btnGuardar" Content="Nuevo / Guardar" Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" Click="btnGuardar_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Búsqueda -->
                <Border Style="{StaticResource FilterBarBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Buscar por nombre de usuario" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtBuscar" Width="260" HorizontalAlignment="Left"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="40"
                                 TextChanged="txtBuscar_TextChanged"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid -->
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="dgvUsuarios"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Nombre de Usuario" Binding="{Binding NombreUsuario}" Width="*"/>
                                <DataGridTextColumn Header="Rol Asignado" Binding="{Binding Rol}" Width="200"/>
                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="Editar" Click="btnEditar_Click">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource AccionIconoEditar}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}"
                                                        ToolTip="Eliminar" Click="btnEliminar_Click">
                                                    <TextBlock Text="&#xE107;" Style="{StaticResource AccionIconoEliminar}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Estado vacío -->
                        <Border x:Name="borderSinUsuarios" Visibility="Collapsed"
                                Background="White" CornerRadius="12">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                                <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="48" Foreground="{StaticResource BorderLightBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="No hay usuarios registrados"
                                           HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
