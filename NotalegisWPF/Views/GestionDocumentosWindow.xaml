<Window x:Class="Notalegis.Views.GestionDocumentosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Gestión de Documentos"
        Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header blanco -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="txtTitulo" Text="DOCUMENTOS" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0"
                            Click="btnSubir_Click" ToolTip="Agregar un nuevo documento">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Subir Archivo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0"
                            Click="btnAbrirCarpeta_Click" ToolTip="Abrir ubicación en el explorador">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Ver en Carpeta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34"
                            Click="btnActualizar_Click" ToolTip="Actualizar">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="4,0,0,0"
                            Click="btnCerrar_Click" ToolTip="Cerrar">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <!-- Tabla de archivos -->
            <Border Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          x:Name="dgArchivos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          CellStyle="{StaticResource ModernDataGridCell}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tipo" Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{StaticResource PrimaryBlueBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Fecha Modificación"
                                            Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Tamaño (KB)"
                                            Binding="{Binding Length, StringFormat={}{0:N0}}"
                                            Width="100"/>
                        <DataGridTemplateColumn Header="Acciones" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                ToolTip="Abrir" Click="btnAbrirArchivo_Click" Margin="2">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource PrimaryBlueBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                                ToolTip="Eliminar" Click="btnEliminarArchivo_Click" Margin="2">
                                            <TextBlock Text="&#xE107;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Estado vacío -->
            <Border x:Name="borderSinDocumentos" Visibility="Collapsed"
                    Background="White" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                               Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No hay documentos adjuntos." HorizontalAlignment="Center"
                               FontSize="15" Foreground="#95A5A6" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock x:Name="txtEstado" Text="Listo"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
