<Window x:Class="Notalegis.Views.ConsultarTurnoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Consultar Turno"
        Icon="/Resources/logo.png"
        Height="650"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Consultar Turno" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,0">

                <!-- Información del Cliente -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Información del Cliente" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="txtCliente" IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Cliente"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 materialDesign:TextFieldAssist.HasClearButton="False"/>
                    </StackPanel>
                </Border>

                <!-- Fecha y Hora -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Fecha y Hora" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtFecha" IsReadOnly="True" Margin="0,8"
                                     materialDesign:HintAssist.Hint="Fecha del Turno"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     materialDesign:TextFieldAssist.HasClearButton="False"/>
                            <TextBox Grid.Column="2" x:Name="txtHora" IsReadOnly="True" Margin="0,8"
                                     materialDesign:HintAssist.Hint="Hora del Turno"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     materialDesign:TextFieldAssist.HasClearButton="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tipo de Trámite -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Tipo de Trámite" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="txtTipoTramite" IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Tipo de Trámite"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 materialDesign:TextFieldAssist.HasClearButton="False"/>
                    </StackPanel>
                </Border>

                <!-- Estado y Confirmación -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Estado y Confirmación" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtEstado" IsReadOnly="True" Margin="0,8"
                                     materialDesign:HintAssist.Hint="Estado del Turno"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     materialDesign:TextFieldAssist.HasClearButton="False"/>
                            <TextBox Grid.Column="2" x:Name="txtConfirmado" IsReadOnly="True" Margin="0,8"
                                     materialDesign:HintAssist.Hint="Confirmado por Cliente"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                     materialDesign:TextFieldAssist.HasClearButton="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Observaciones -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Observaciones" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="txtObservaciones" IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Observaciones del Turno"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 materialDesign:TextFieldAssist.HasClearButton="False"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar" Style="{StaticResource PrimaryButton}"
                        Padding="20,8"
                        Click="btnCerrar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
