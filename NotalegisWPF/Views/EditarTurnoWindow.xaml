<Window x:Class="Notalegis.Views.EditarTurnoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Turno"
        Icon="/Resources/logo.png"
        Height="580" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Editar Turno" FontSize="17" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Modificá la fecha, hora o estado del turno" FontSize="12"
                                   Foreground="#B8D0FF"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseDialogButton}" HorizontalAlignment="Right"
                        Click="btnCancelar_Click" ToolTip="Cerrar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <StackPanel>

                    <TextBlock Text="Cliente" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <ComboBox x:Name="cmbCliente" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Cliente"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                              IsEditable="False" IsEnabled="False"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Fecha y hora" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="dpFecha"
                                    materialDesign:HintAssist.Hint="Fecha del Turno *"
                                    materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>
                        <materialDesign:TimePicker Grid.Column="2" x:Name="txtHora"
                                                   materialDesign:HintAssist.Hint="Hora del Turno *"
                                                   Style="{StaticResource MaterialDesignOutlinedTimePicker}"/>
                    </Grid>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Trámite y estado" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <ComboBox x:Name="cmbTramite" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Tipo de Trámite *"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                              IsEditable="True"/>

                    <ComboBox x:Name="cmbEstado" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Estado del Turno"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Observaciones" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <TextBox x:Name="txtObservaciones" Margin="0,0,0,4"
                             materialDesign:HintAssist.Hint="Observaciones adicionales (Opcional)"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="80" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="* Campos obligatorios" FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>
                <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
