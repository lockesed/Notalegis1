<Window x:Class="Notalegis.Views.SeleccionMesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Seleccionar Mes y Año"
        Icon="/Resources/logo.png"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Seleccionar Período" FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <StackPanel>
                    <TextBlock Text="Seleccione el mes y año para generar el listado:"
                               Margin="0,0,0,16" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <ComboBox x:Name="cmbMes" Margin="0,8"
                              materialDesign:HintAssist.Hint="Mes"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"/>

                    <ComboBox x:Name="cmbAnio" Margin="0,8"
                              materialDesign:HintAssist.Hint="Año"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>
                <Button Content="Aceptar" Style="{StaticResource PrimaryButton}"
                        Padding="20,8"
                        Click="btnAceptar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
