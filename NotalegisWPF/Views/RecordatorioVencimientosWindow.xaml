<Window x:Class="Notalegis.Views.RecordatorioVencimientosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Recordatorio de Vencimientos"
        Height="500" Width="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="400"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul modal (advertencia de vencimientos) -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock x:Name="lblTitulo" Text="Trámites próximos a vencer"
                                   FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="lblSubtitulo" Text="Los siguientes trámites vencen en los próximos 7 días"
                                   FontSize="12" Foreground="#B8D0FF"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla de vencimientos -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="12,12,12,4">
            <DataGrid x:Name="dgVencimientos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Días restantes" Binding="{Binding DiasRestantes}" Width="110">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vence el" Binding="{Binding FechaVencimiento, StringFormat=dd/MM/yyyy}" Width="100">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tipo de trámite" Binding="{Binding TipoTramite}" Width="180">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="80">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <DockPanel>
                <TextBlock x:Name="lblConteo" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Ir a trámites" Style="{StaticResource PrimaryButton}"
                            Padding="15,8" Margin="0,0,10,0" Click="btnIrATramites_Click"/>
                    <Button Content="Entendido" Style="{StaticResource SecondaryButton}"
                            Padding="15,8" Click="btnCerrar_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
