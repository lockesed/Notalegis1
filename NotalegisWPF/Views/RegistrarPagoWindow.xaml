<Window x:Class="Notalegis.Views.RegistrarPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Registrar Pago — Notalegis"
        Icon="/Resources/logo.png"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EB;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Registrar Pago" FontSize="17" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Name="ExpedienteHeaderText" FontSize="12" Foreground="#B8D0FF"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseDialogButton}" HorizontalAlignment="Right"
                        Click="CancelarButton_Click" ToolTip="Cerrar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,0">

                <!-- Info del presupuesto (solo lectura) -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Información del presupuesto" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cliente:" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Name="ClienteText" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,12"/>
                                <TextBlock Text="Tipo de Trámite:" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Name="TipoTramiteText" FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Presupuesto:" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Name="TotalPresupuestoText" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,2,0,12"/>
                                <TextBlock Text="Saldo Actual:" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Name="SaldoActualText" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Datos del pago -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Datos del pago" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                        <TextBox Name="MontoPagoTextBox" Margin="0,0,0,10"
                                 materialDesign:HintAssist.Hint="Monto del Pago"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 TextChanged="MontoPagoTextBox_TextChanged"
                                 PreviewTextInput="NumberValidationTextBox"/>

                        <ComboBox Name="MetodoPagoComboBox" Margin="0,0,0,10"
                                  materialDesign:HintAssist.Hint="Método de Pago"
                                  materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                                  SelectionChanged="MetodoPagoComboBox_SelectionChanged">
                            <ComboBoxItem Content="Efectivo"/>
                            <ComboBoxItem Content="Transferencia Bancaria"/>
                            <ComboBoxItem Content="Cheque"/>
                            <ComboBoxItem Content="Tarjeta de Débito"/>
                            <ComboBoxItem Content="Tarjeta de Crédito"/>
                            <ComboBoxItem Content="Múltiples Métodos"/>
                        </ComboBox>

                        <DatePicker Name="FechaPagoDatePicker" Margin="0,0,0,10"
                                    materialDesign:HintAssist.Hint="Fecha del Pago"
                                    materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>

                        <TextBox Name="ObservacionesTextBox"
                                 materialDesign:HintAssist.Hint="Observaciones (opcional)"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxLines="3"/>
                    </StackPanel>
                </Border>

                <!-- Resumen del pago -->
                <Border Style="{StaticResource CardBorder}"
                        Background="{StaticResource AppBgBrush}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Resumen del pago" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monto Actual Abonado:" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Name="MontoActualAbonadoText" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,10"/>
                                <TextBlock Text="Nuevo Monto a Abonar:" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Name="NuevoMontoText" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total que Quedará Abonado:" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Name="TotalQuedaraAbonadoText" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,2,0,10"/>
                                <TextBlock Text="Saldo Restante:" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Name="SaldoRestanteText" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="NUEVO ESTADO:" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Name="NuevoEstadoBorder" CornerRadius="20" Padding="12,5" Margin="10,0,0,0">
                                <TextBlock Name="NuevoEstadoText" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0"
                        Click="CancelarButton_Click"/>
                <Button Name="GuardarButton" Content="Registrar pago"
                        Style="{StaticResource PrimaryButton}"
                        Padding="20,8" IsEnabled="False"
                        Click="GuardarButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
