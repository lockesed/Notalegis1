<Window x:Class="Notalegis.Views.AcercaDeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de Notalegis" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con color -->
        <Border Grid.Row="0" Background="#2C3E50">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Resources/logo.png" Width="48" Height="48" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NOTALEGIS" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Sistema de Gestión para Escribanías" Foreground="#BDC3C7" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cuerpo de información -->
        <StackPanel Grid.Row="1" Margin="40,24,40,16" VerticalAlignment="Top">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Versión:" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Grid.Column="1" Text="1.0.0" Foreground="{DynamicResource MaterialDesignBody}"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Año:" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Grid.Column="1" Text="2026" Foreground="{DynamicResource MaterialDesignBody}"/>
            </Grid>

            <Separator Margin="0,8,0,16" Background="#DDE"/>

            <TextBlock Text="Soporte técnico" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Email:" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Grid.Column="1" Text="soporte@notalegis.com.ar" Foreground="#2980B9"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Teléfono:" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Grid.Column="1" Text="+54 11 XXXX-XXXX" Foreground="{DynamicResource MaterialDesignBody}"/>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Horario:" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock Grid.Column="1" Text="Lunes a Viernes, 9:00 – 18:00" Foreground="{DynamicResource MaterialDesignBody}"/>
            </Grid>

        </StackPanel>

        <!-- Pie de ventana -->
        <Border Grid.Row="2" Background="#EAECEE" BorderBrush="#DDE" BorderThickness="0,1,0,0">
            <Button Content="CERRAR" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#2C3E50" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Padding="15,8" Cursor="Hand"
                    Click="btnCerrar_Click"/>
        </Border>
    </Grid>
</Window>
