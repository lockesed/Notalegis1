<Window x:Class="Notalegis.Views.EditarClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Cliente"
        Icon="/Resources/logo.png"
        Height="580" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Editar Cliente" FontSize="17" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Modificá los datos del cliente" FontSize="12"
                                   Foreground="#B8D0FF"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseDialogButton}" HorizontalAlignment="Right"
                        Click="btnCancelar_Click" ToolTip="Cerrar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <StackPanel>

                    <TextBlock Text="Información personal" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtNombre" Margin="0,0,0,10"
                                 materialDesign:HintAssist.Hint="Nombre *"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                        <TextBox Grid.Column="2" x:Name="txtApellido" Margin="0,0,0,10"
                                 materialDesign:HintAssist.Hint="Apellido *"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                    </Grid>

                    <TextBox x:Name="txtDocumento" Margin="0,0,0,10" MaxLength="11"
                             materialDesign:HintAssist.Hint="DNI/CUIT *"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Datos de contacto" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <TextBox x:Name="txtTelefono" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Teléfono"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <TextBox x:Name="txtEmail" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Email"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <TextBox x:Name="txtDireccion" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Dirección"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Estado y observaciones" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <ComboBox x:Name="cmbEstado" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Estado del cliente"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                        <ComboBoxItem Content="Activo"/>
                        <ComboBoxItem Content="En Trámite"/>
                        <ComboBoxItem Content="Finalizado"/>
                        <ComboBoxItem Content="Suspendido"/>
                    </ComboBox>

                    <TextBox x:Name="txtObservaciones" Margin="0,0,0,4"
                             materialDesign:HintAssist.Hint="Observaciones"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="80" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="* Campos obligatorios" FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>
                <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
