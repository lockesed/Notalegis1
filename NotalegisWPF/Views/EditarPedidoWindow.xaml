<Window x:Class="Notalegis.Views.EditarPedidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Pedido de Hojas Protocolares"
        Icon="/Resources/logo.png"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul modal -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Editar Pedido de Hojas Protocolares"
                               FontSize="17" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <StackPanel>
                    <DatePicker x:Name="dpFechaPedido" Margin="0,0,0,12"
                                materialDesign:HintAssist.Hint="Fecha del Pedido *"
                                materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>

                    <TextBox x:Name="txtTipoInsumo" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Tipo de Insumo *"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             Text="Hojas Protocolares"
                             IsReadOnly="True"/>

                    <TextBox x:Name="txtCantidad" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Cantidad *"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             PreviewTextInput="txtCantidad_PreviewTextInput"/>

                    <TextBox x:Name="txtSolicitante" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Solicitante (Escribano) *"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <ComboBox x:Name="cmbEstado" Margin="0,0,0,12"
                              materialDesign:HintAssist.Hint="Estado *"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"/>

                    <TextBox x:Name="txtEmailDestino" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Email Destino (Opcional)"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <TextBox x:Name="txtObservaciones" Margin="0,0,0,12"
                             materialDesign:HintAssist.Hint="Observaciones (Opcional)"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             VerticalScrollBarVisibility="Auto"/>

                    <CheckBox x:Name="chkFirmado" Content="Pedido Firmado" Margin="0,4,0,0"
                              Style="{StaticResource MaterialDesignCheckBox}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer modal -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0" Click="btnCancelar_Click"/>
                <Button Content="Guardar Cambios" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
