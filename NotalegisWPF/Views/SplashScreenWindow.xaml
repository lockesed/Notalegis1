<Window x:Class="Notalegis.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="480" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border CornerRadius="14"
            Background="{StaticResource SidebarBgBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="&#xE8A9;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           Foreground="White"/>

                <TextBlock Text="NOTALEGIS"
                           FontFamily="Segoe UI"
                           FontSize="34" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,6"/>

                <TextBlock Text="Sistema de Gestión para Escribanías"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="White"
                           Opacity="0.80"
                           HorizontalAlignment="Center"/>

                <ProgressBar x:Name="progressBar"
                             IsIndeterminate="True"
                             Width="200"
                             Height="3"
                             Margin="0,32,0,0"
                             Foreground="{StaticResource PrimaryBlueBrush}"
                             Background="Transparent"/>

                <TextBlock x:Name="txtEstado"
                           Text="Iniciando…"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="White"
                           Opacity="0.60"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <TextBlock Text="v1.0 — 2026"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       FontFamily="Segoe UI"
                       Foreground="White"
                       Opacity="0.40"
                       FontSize="11"/>
        </Grid>
    </Border>
</Window>
