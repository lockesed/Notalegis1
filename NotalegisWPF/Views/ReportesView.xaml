<Window x:Class="Notalegis.Views.ReportesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notalegis - Reportes"
        Icon="/Resources/logo.png"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        UseLayoutRounding="True"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Reportes" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtDescripcionReporte" Text=""
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <Button Content="Cerrar" Style="{StaticResource SecondaryButton}"
                        Padding="14,7" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="btnCerrar_Click"/>
            </Grid>
        </Border>

        <!-- Cuerpo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="250" MaxWidth="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: lista de reportes + filtros -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="12,12,6,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Reportes de Clientes -->
                        <TextBlock Text="CLIENTES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ListBox x:Name="lstReportes" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="lstReportes_SelectionChanged" Margin="0,0,0,4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBlueLightBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#F0F4FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nombre}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Separator Margin="0,12,0,12" Background="{StaticResource BorderLightBrush}"/>

                        <!-- Filtro de fechas -->
                        <TextBlock x:Name="lblFiltroFechas" Text="PERÍODO" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                        <StackPanel x:Name="panelFechas">
                            <TextBlock Text="Desde" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <DatePicker x:Name="dpDesde"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                        materialDesign:HintAssist.Hint="Desde"
                                        Margin="0,0,0,8"
                                        SelectedDateChanged="Fecha_Changed"/>
                            <TextBlock Text="Hasta" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <DatePicker x:Name="dpHasta"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                        materialDesign:HintAssist.Hint="Hasta"
                                        Margin="0,0,0,8"
                                        SelectedDateChanged="Fecha_Changed"/>
                        </StackPanel>

                        <Separator Margin="0,4,0,12" Background="{StaticResource BorderLightBrush}"/>

                        <!-- Exportar -->
                        <TextBlock Text="EXPORTAR" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                        <Button x:Name="btnExportarExcel" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                IsEnabled="False" Click="btnExportarExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Exportar a Excel"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel derecho: datos -->
            <Grid Grid.Column="1" Margin="6,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra info -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="16,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTituloReporte"
                                       Text="Seleccioná un reporte para comenzar"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Filas: " FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtConteoFilas" Text="—"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="btnActualizar" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                    FontSize="14" Width="32" Height="32"
                                    Style="{StaticResource IconButton}" Margin="12,0,0,0"
                                    ToolTip="Actualizar" Click="btnActualizar_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid principal -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <!-- Estado vacío -->
                        <StackPanel x:Name="panelVacio" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                       Foreground="{StaticResource BorderLightBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Seleccioná un reporte del panel izquierdo"
                                       FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- DataGrid con columnas auto-generadas -->
                        <DataGrid x:Name="dgReporte"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  Style="{StaticResource ModernDataGrid}"
                                  Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Totales (solo para reportes de facturación) -->
                <Border x:Name="panelTotales" Grid.Row="2"
                        Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="16,12"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total facturado en el período:" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotal" Text="$0"
                                   FontSize="18" FontWeight="Bold" Margin="12,0,0,0"
                                   Foreground="{StaticResource PrimaryBlueBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalPagado" Text=""
                                   FontSize="13" Margin="24,0,0,0"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalPendiente" Text=""
                                   FontSize="13" Margin="16,0,0,0"
                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
