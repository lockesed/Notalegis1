<Window x:Class="Notalegis.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Notalegis - Sistema de Gestión para Escribanías"
        Icon="/Resources/logo.png"
        MinHeight="600" MinWidth="1024"
        d:DesignHeight="800" d:DesignWidth="1280"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP BAR ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Zona del logo (alineada con sidebar) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" Padding="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#C79A3A">
                        <TextBlock Text="N" FontSize="18" FontWeight="Bold" Foreground="#1B2A44"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Notalegis" Foreground="White"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Gestión Notarial"
                                   Foreground="{StaticResource SidebarTextMutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Barra superior (blanca) -->
            <Border Grid.Column="1" Grid.ColumnSpan="3"
                    Background="{StaticResource TopBarBgBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Saludo y fecha -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblFecha" Text="—"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock x:Name="lblSaludo" Text="Buen día"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Acciones derecha -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                                ToolTip="Notificaciones">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Content="Acerca de" Style="{StaticResource LinkButton}"
                                Margin="0,0,16,0" Click="btnAcercaDe_Click"/>
                        <Button Content="Cerrar sesión" Style="{StaticResource SecondaryButton}"
                                Padding="12,7" Click="CerrarSesion_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== MAIN AREA ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Navegación -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="12,16,12,0">
                    <StackPanel>

                        <!-- Módulos principales -->
                        <Button Content="Inicio" Tag="&#xE80F;"
                                Style="{StaticResource SidebarNavActive}"/>

                        <Button Content="Agenda / Turnos" Tag="&#xE787;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnTurnos_Click"/>

                        <Button Content="Escrituras" Tag="&#xE8A9;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnEscrituras_Click"/>

                        <Button Content="Clientes" Tag="&#xE716;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnClientes_Click"/>

                        <Button Content="Trámites" Tag="&#xE74D;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnTramites_Click"/>

                        <Button x:Name="btnModuloCobros" Content="Cobros" Tag="&#xE8C7;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnCobros_Click"/>

                        <Button x:Name="btnModuloPedidosInsumos" Content="Pedidos de Insumos" Tag="&#xECAA;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnPedidosInsumos_Click"/>

                        <Button x:Name="btnModuloEstadisticas" Content="Estadísticas" Tag="&#xE9D2;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnEstadisticas_Click"/>

                        <Button x:Name="btnModuloReportes" Content="Reportes" Tag="&#xE9F9;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnReportes_Click"/>

                        <!-- Separador Administración -->
                        <Border Height="1" Background="#253856" Margin="8,14,8,8"/>

                        <TextBlock Text="ADMINISTRACIÓN"
                                   Foreground="{StaticResource SidebarTextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Margin="12,0,0,8"/>

                        <Button x:Name="btnModuloUsuarios" Content="Usuarios" Tag="&#xE8D3;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnUsuarios_Click"/>

                        <Button x:Name="btnModuloAuditoria" Content="Auditoría" Tag="&#xE8AD;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnAuditoria_Click"/>

                        <Button x:Name="btnModuloRespaldo" Content="Copias de Seguridad" Tag="&#xEDA3;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnRespaldo_Click"/>

                        <Button x:Name="btnModuloConfiguracion" Content="Configuración" Tag="&#xE713;"
                                Style="{StaticResource SidebarNavItem}"
                                Click="btnConfiguracion_Click"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Perfil de usuario -->
                <Border Grid.Row="1" Margin="12" Padding="12" CornerRadius="10"
                        Background="{StaticResource SidebarUserBgBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{StaticResource PrimaryBlueBrush}">
                            <TextBlock x:Name="lblUserInitials" Text="?"
                                       Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblUserName" Text="Usuario"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="lblUsuario" Text="Rol"
                                       Foreground="{StaticResource SidebarTextMutedBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== CONTENIDO PRINCIPAL ===== -->
            <Grid Grid.Column="1" Background="{StaticResource AppBgBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24">

                        <!-- KPI Cards -->
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">

                            <!-- Turnos hoy -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtKpiTurnos" Text="—"
                                                   FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Turnos hoy"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10"
                                            Background="{StaticResource PrimaryBlueLightBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{StaticResource PrimaryBlueBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Trámites activos -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtKpiTramitesActivos" Text="—"
                                                   FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Trámites activos"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10"
                                            Background="{StaticResource SuccessLightBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Vencimientos próximos -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtKpiVencimientos" Text="—"
                                                   FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Vencimientos próximos"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10"
                                            Background="{StaticResource WarningLightBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Cobros del mes -->
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtKpiCobros" Text="—"
                                                   FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Cobros este mes"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10"
                                            Background="#F3E8FF" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="#9333EA"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                        </UniformGrid>

                        <!-- Agenda + Paneles derecho -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Agenda de hoy -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <TextBlock Text="Agenda de hoy"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Button Content="Ver turnos completos"
                                                Style="{StaticResource LinkButton}"
                                                HorizontalAlignment="Right"
                                                Click="btnTurnos_Click"/>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" MaxHeight="400"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="eventosPanel" VerticalAlignment="Top"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Panel derecho -->
                            <StackPanel Grid.Column="1">

                                <!-- Vencimientos y alertas -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Vencimientos y alertas"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,12"/>
                                        <StackPanel x:Name="vencimientosPanel"/>
                                        <!-- Estado vacío -->
                                        <TextBlock x:Name="lblSinVencimientos"
                                                   Text="Sin vencimientos próximos"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" FontStyle="Italic"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Accesos rápidos -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Accesos rápidos"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,12"/>
                                        <Button Content="+ Nuevo trámite"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                Click="btnTramites_Click"/>
                                        <Button Content="+ Nuevo turno"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,0,8"
                                                Click="btnTurnos_Click"/>
                                        <Button Content="+ Nueva escritura"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Stretch"
                                                Click="btnEscrituras_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Calendar oculto (code-behind lo usa internamente) -->
                <Calendar x:Name="mainCalendar" Visibility="Collapsed"
                          SelectedDatesChanged="mainCalendar_SelectedDatesChanged"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
