<Window x:Class="Notalegis.Views.EditarTramiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Trámite"
        Icon="/Resources/logo.png"
        Height="700" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Editar Trámite" FontSize="17" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Modificá los datos del trámite" FontSize="12"
                                   Foreground="#B8D0FF"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseDialogButton}" HorizontalAlignment="Right"
                        Click="btnCancelar_Click" ToolTip="Cerrar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <StackPanel>

                    <TextBlock Text="Cliente" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <ComboBox x:Name="cmbCliente" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Seleccionar Cliente *"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}"
                              IsEditable="True"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Tipo de trámite" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <ComboBox x:Name="cmbTipoTramite" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Seleccionar Tipo de Trámite *"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                        <ComboBoxItem Content="Escritura de Compraventa"/>
                        <ComboBoxItem Content="Constitución de Sociedad"/>
                        <ComboBoxItem Content="Poder General"/>
                        <ComboBoxItem Content="Certificado de Dominio"/>
                        <ComboBoxItem Content="Testamento"/>
                        <ComboBoxItem Content="Donación"/>
                        <ComboBoxItem Content="Hipoteca"/>
                        <ComboBoxItem Content="Cancelación de Hipoteca"/>
                        <ComboBoxItem Content="Usufructo"/>
                        <ComboBoxItem Content="Servidumbre"/>
                        <ComboBoxItem Content="Consulta General"/>
                    </ComboBox>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Fechas" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="dpFechaInicio"
                                    materialDesign:HintAssist.Hint="Fecha de Inicio *"
                                    materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>
                        <DatePicker Grid.Column="2" x:Name="dpFechaVencimiento"
                                    materialDesign:HintAssist.Hint="Fecha de Vencimiento *"
                                    materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>
                    </Grid>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Estado y prioridad" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="cmbEstado"
                                  materialDesign:HintAssist.Hint="Estado del Trámite"
                                  materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                            <ComboBoxItem Content="Pendiente" IsSelected="True"/>
                            <ComboBoxItem Content="En Proceso"/>
                            <ComboBoxItem Content="Documentación Incompleta"/>
                            <ComboBoxItem Content="Esperando Cliente"/>
                            <ComboBoxItem Content="Finalizado"/>
                            <ComboBoxItem Content="Vencido"/>
                            <ComboBoxItem Content="Cancelado"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" x:Name="cmbPrioridad"
                                  materialDesign:HintAssist.Hint="Prioridad"
                                  materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                            <ComboBoxItem Content="Baja"/>
                            <ComboBoxItem Content="Media" IsSelected="True"/>
                            <ComboBoxItem Content="Alta"/>
                            <ComboBoxItem Content="Urgente"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="chkDocumentacionCompleta" Margin="0,4,0,10"
                              Content="Documentación completa y verificada"
                              Style="{StaticResource MaterialDesignCheckBox}"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Información adicional" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtNumeroExpediente"
                                 materialDesign:HintAssist.Hint="Número de Expediente"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                        <TextBox Grid.Column="2" x:Name="txtMontoEstimado"
                                 materialDesign:HintAssist.Hint="Monto Estimado ($)"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 PreviewTextInput="NumberValidationTextBox"/>
                    </Grid>

                    <TextBox x:Name="txtObservaciones" Margin="0,0,0,4"
                             materialDesign:HintAssist.Hint="Observaciones del trámite"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="80" VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="* Campos obligatorios" FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>
                <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
