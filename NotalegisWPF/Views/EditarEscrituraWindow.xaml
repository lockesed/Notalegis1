<Window x:Class="Notalegis.Views.EditarEscrituraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Editar Escritura"
        Icon="/Resources/logo.png"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header azul -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeaderBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Editar Escritura Pública" FontSize="17" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock x:Name="txtTitulo" FontSize="12" Foreground="#B8D0FF"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource CloseDialogButton}" HorizontalAlignment="Right"
                        Click="btnCancelar_Click" ToolTip="Cerrar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Formulario -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorder}" Margin="16,16,16,0">
                <StackPanel>

                    <TextBlock Text="Datos de la escritura" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <!-- Cliente y Tipo (solo lectura) -->
                    <TextBox x:Name="txtCliente" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Cliente"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             IsReadOnly="True"/>

                    <TextBox x:Name="txtTipoEscritura" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Tipo de Escritura"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             IsReadOnly="True"/>

                    <!-- Campos editables -->
                    <TextBox x:Name="txtNumeroProtocolo" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Número de Protocolo *"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                    <DatePicker x:Name="dpFecha" Margin="0,0,0,10"
                                materialDesign:HintAssist.Hint="Fecha de la Escritura *"
                                materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisDatePicker}"/>

                    <ComboBox x:Name="cmbEstado" Margin="0,0,0,10"
                              materialDesign:HintAssist.Hint="Estado *"
                              materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                        <ComboBoxItem Content="Borrador"/>
                        <ComboBoxItem Content="Finalizada"/>
                        <ComboBoxItem Content="Protocolizada"/>
                        <ComboBoxItem Content="Archivada"/>
                    </ComboBox>

                    <TextBox x:Name="txtObservaciones" Margin="0,0,0,10"
                             materialDesign:HintAssist.Hint="Observaciones"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

                    <Separator Margin="0,8,0,16"/>

                    <TextBlock Text="Información del archivo" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,14"/>

                    <TextBox x:Name="txtRutaArchivo" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Ruta del Archivo"
                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                             IsReadOnly="True"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtFechaCreacion"
                                 materialDesign:HintAssist.Hint="Fecha de Creación"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 IsReadOnly="True"/>
                        <TextBox Grid.Column="2" x:Name="txtFechaProtocolizacion"
                                 materialDesign:HintAssist.Hint="Fecha de Protocolización"
                                 materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"
                                 IsReadOnly="True"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="btnAdjuntarArchivo" Content="Adjuntar archivo"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7" Margin="0,0,10,0"
                                Click="btnAdjuntarArchivo_Click">
                            <Button.ToolTip>
                                <ToolTip Content="Adjuntar o reemplazar archivo de la escritura"/>
                            </Button.ToolTip>
                        </Button>
                        <Button x:Name="btnAbrirArchivo" Content="Abrir archivo"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7" Click="btnAbrirArchivo_Click">
                            <Button.ToolTip>
                                <ToolTip Content="Abrir el archivo actual"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer con botones -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooterBorder}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>
                <Button Content="Guardar cambios" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
