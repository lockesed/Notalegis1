<Window x:Class="Notalegis.Views.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Notalegis.Views"
        mc:Ignorable="d"
        Title="Notalegis — Configuración del Sistema"
        Icon="/Resources/logo.png"
        Height="800" Width="1100"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource PrimaryBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Configuración del Sistema" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Parámetros generales que aplican a toda la aplicación"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pestañas -->
        <TabControl Grid.Row="1" Margin="24,20,24,0"
                    Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="16,10"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Datos Oficiales -->
            <TabItem Header="Datos Oficiales">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Información de la Escribanía" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Datos formales utilizados para encabezados, PDFs y reportes."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                            <TextBox Name="txtEscribaniaNombre" Margin="0,0,0,24"
                                     materialDesign:HintAssist.Hint="Nombre de la Escribanía u Oficina (ej: Registro Notarial N° 15)"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="150"/>

                            <TextBox Name="txtEscribaniaDireccion" Margin="0,0,0,24"
                                     materialDesign:HintAssist.Hint="Dirección Comercial"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="200"/>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="txtEscribaniaTelefono"
                                         materialDesign:HintAssist.Hint="Teléfono (incluir código país, ej: 549...)"
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="50"/>
                                <TextBox Grid.Column="2" Name="txtEscribaniaEmail"
                                         materialDesign:HintAssist.Hint="Correo Electrónico Oficial"
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="100"/>
                            </Grid>

                            <Separator Margin="0,8,0,16"/>

                            <TextBlock Text="Datos notariales" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Utilizados en los documentos generados por IA."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Name="txtEscribaniaCiudad" Margin="0,0,0,24"
                                             materialDesign:HintAssist.Hint="Ciudad de otorgamiento (ej: San Juan)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="100"/>
                                    <TextBox Name="txtEscribaniaNumeroRegistro"
                                             materialDesign:HintAssist.Hint="Número de Registro Notarial (solo el número)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="20"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox Name="txtEscribaniaProvincia" Margin="0,0,0,24"
                                             materialDesign:HintAssist.Hint="Provincia (ej: Neuquén)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="100"/>
                                    <TextBox Name="txtEscribaniaEscribano"
                                             materialDesign:HintAssist.Hint="Nombre del Escribano/a Titular"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="150"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Impuestos y Tasas -->
            <TabItem Header="Impuestos y Tasas (%)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Tasas e Impuestos por Defecto" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Estos porcentajes se utilizarán por defecto al calcular nuevos cobros."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Name="txtIva" Margin="0,0,0,24"
                                             materialDesign:HintAssist.Hint="IVA (%)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="10"/>
                                    <TextBox Name="txtGanancias" Margin="0,0,0,24"
                                             materialDesign:HintAssist.Hint="Retención de Ganancias (%)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="10"/>
                                    <TextBox Name="txtHonorarios"
                                             materialDesign:HintAssist.Hint="Honorarios Sugeridos (%)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBox Name="txtSellos" Margin="0,0,0,24"
                                             materialDesign:HintAssist.Hint="Impuesto a los Sellos (%)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="10"/>
                                    <TextBox Name="txtIti" Margin="0,0,0,24"
                                             materialDesign:HintAssist.Hint="ITI — Transf. de Inmuebles (%)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="10"/>
                                    <TextBox Name="txtTasaGeneral"
                                             materialDesign:HintAssist.Hint="Tasa General (%)"
                                             materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}" MaxLength="10"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Plantillas WhatsApp -->
            <TabItem Header="Plantillas WhatsApp">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Mensajes Predefinidos de WhatsApp" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Variables: {0} = Nombre Cliente / {1} = Tipo Trámite / {2} = Vencimiento o Estado / {Escribania_Nombre} / {Escribania_Direccion}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <TextBlock Text="Aviso de Trámite Listo para Firma" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBox Name="txtWhatsappFirma" Margin="0,0,0,20"
                                     Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>

                            <TextBlock Text="Seguimiento Genérico de Trámite" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBox Name="txtWhatsappSeguimiento"
                                     Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Inteligencia Artificial -->
            <TabItem Header="Inteligencia Artificial">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Integración con Claude (Anthropic)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Configure la API para generar borradores de escrituras automáticamente."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="API Key de Claude (Anthropic)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="pwdApiKey" Margin="0,0,0,6"
                                         materialDesign:HintAssist.Hint="sk-ant-..."
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisPasswordBox}"/>
                            <TextBlock Text="Obtené tu clave en console.anthropic.com → API Keys. Nunca la compartas."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="Modelo de IA" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cmbModeloIA" Margin="0,0,0,6"
                                      materialDesign:HintAssist.Hint="Seleccionar modelo"
                                      materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisComboBox}">
                                <ComboBoxItem Content="claude-haiku-4-5-20251001 — Rápido y económico (~$1.50/mes por 100 escrituras)"
                                              Tag="claude-haiku-4-5-20251001"/>
                                <ComboBoxItem Content="claude-sonnet-4-6 — Mayor calidad (~$5/mes por 100 escrituras)"
                                              Tag="claude-sonnet-4-6"/>
                            </ComboBox>
                            <TextBlock Text="Haiku es ideal para la mayoría de los casos. Sonnet genera textos más precisos y detallados."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="Límite de tokens por respuesta" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtIAMaxTokens" Margin="0,0,0,18" MaxLength="6"
                                     materialDesign:HintAssist.Hint="Valor recomendado: 8192"
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                            <TextBlock Text="Mínimo 1024. Haiku soporta hasta 8192; Sonnet hasta 16384."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="PDF de normativa vigente" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Si seleccionás un PDF, la IA lo usará como contexto normativo en cada escritura."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtRutaNormativaPDF" Grid.Column="0" IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="(ninguno seleccionado)"
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                                <Button Grid.Column="2" Content="Seleccionar PDF"
                                        Style="{StaticResource SecondaryButton}" Padding="14,8"
                                        Click="btnSeleccionarNormativaPDF_Click"/>
                                <Button Grid.Column="4" Content="Quitar"
                                        Style="{StaticResource SecondaryButton}" Padding="14,8"
                                        Click="btnQuitarNormativaPDF_Click"/>
                            </Grid>

                            <TextBlock Text="Instrucciones predefinidas (prompt base)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Texto opcional que se agrega a cada pedido de escritura. Útil para preferencias de estilo o directrices específicas."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtPromptBase" Height="110" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     materialDesign:HintAssist.Hint="Instrucciones adicionales para la IA..."
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondaryBrush}" materialDesign:HintAssist.Background="White" Style="{StaticResource NotalegisTextBox}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer con botones -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0"
                Padding="24,16" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        Padding="20,8" Margin="0,0,12,0" Click="btnCancelar_Click"/>
                <Button Content="Guardar Modificaciones" Style="{StaticResource PrimaryButton}"
                        Padding="20,8" Click="btnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
