<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== PALETA DE COLORES NOTALEGIS ===== -->

    <!-- Sidebar -->
    <Color x:Key="SidebarBgColor">#1B2A44</Color>
    <Color x:Key="SidebarNavHoverColor">#253856</Color>
    <Color x:Key="SidebarNavActiveColor">#253856</Color>
    <Color x:Key="SidebarNavActiveBorderColor">#3D7AF5</Color>
    <Color x:Key="SidebarTextMutedColor">#6B87B0</Color>
    <Color x:Key="SidebarUserBgColor">#253856</Color>

    <!-- Fondo de la app -->
    <Color x:Key="AppBgColor">#F4F6FA</Color>
    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <Color x:Key="TopBarBgColor">#FFFFFF</Color>

    <!-- Colores de acento -->
    <Color x:Key="PrimaryBlueColor">#3D7AF5</Color>
    <Color x:Key="PrimaryBlueHoverColor">#2F69E0</Color>
    <Color x:Key="PrimaryBluePressedColor">#2558C8</Color>
    <Color x:Key="PrimaryBlueLightColor">#EEF3FE</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimaryColor">#1E2D3D</Color>
    <Color x:Key="TextSecondaryColor">#6B7A99</Color>
    <Color x:Key="TextMutedColor">#9BAEC4</Color>

    <!-- Bordes -->
    <Color x:Key="BorderLightColor">#E5E9F0</Color>
    <Color x:Key="BorderFocusColor">#3D7AF5</Color>

    <!-- Estados -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="SuccessLightColor">#DCFCE7</Color>
    <Color x:Key="SuccessTextColor">#15803D</Color>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningLightColor">#FEF3C7</Color>
    <Color x:Key="WarningTextColor">#92400E</Color>

    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerHoverColor">#D63030</Color>
    <Color x:Key="DangerLightColor">#FEE2E2</Color>
    <Color x:Key="DangerTextColor">#991B1B</Color>

    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoLightColor">#DBEAFE</Color>
    <Color x:Key="InfoTextColor">#1D4ED8</Color>

    <!-- ===== BRUSHES ===== -->

    <SolidColorBrush x:Key="SidebarBgBrush"              Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarNavHoverBrush"         Color="{StaticResource SidebarNavHoverColor}"/>
    <SolidColorBrush x:Key="SidebarNavActiveBrush"        Color="{StaticResource SidebarNavActiveColor}"/>
    <SolidColorBrush x:Key="SidebarNavActiveBorderBrush"  Color="{StaticResource SidebarNavActiveBorderColor}"/>
    <SolidColorBrush x:Key="SidebarTextMutedBrush"        Color="{StaticResource SidebarTextMutedColor}"/>
    <SolidColorBrush x:Key="SidebarUserBgBrush"           Color="{StaticResource SidebarUserBgColor}"/>

    <SolidColorBrush x:Key="AppBgBrush"                   Color="{StaticResource AppBgColor}"/>
    <SolidColorBrush x:Key="CardBgBrush"                  Color="{StaticResource CardBgColor}"/>
    <SolidColorBrush x:Key="TopBarBgBrush"                Color="{StaticResource TopBarBgColor}"/>

    <SolidColorBrush x:Key="PrimaryBlueBrush"             Color="{StaticResource PrimaryBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueHoverBrush"        Color="{StaticResource PrimaryBlueHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueLightBrush"        Color="{StaticResource PrimaryBlueLightColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"             Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"           Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"               Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="BorderLightBrush"             Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush"             Color="{StaticResource BorderFocusColor}"/>

    <SolidColorBrush x:Key="SuccessBrush"                 Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush"            Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="SuccessTextBrush"             Color="{StaticResource SuccessTextColor}"/>

    <SolidColorBrush x:Key="WarningBrush"                 Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush"            Color="{StaticResource WarningLightColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush"             Color="{StaticResource WarningTextColor}"/>

    <SolidColorBrush x:Key="DangerBrush"                  Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush"             Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush"             Color="{StaticResource DangerLightColor}"/>
    <SolidColorBrush x:Key="DangerTextBrush"              Color="{StaticResource DangerTextColor}"/>

    <SolidColorBrush x:Key="InfoBrush"                    Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush"               Color="{StaticResource InfoLightColor}"/>
    <SolidColorBrush x:Key="InfoTextBrush"                Color="{StaticResource InfoTextColor}"/>

</ResourceDictionary>
